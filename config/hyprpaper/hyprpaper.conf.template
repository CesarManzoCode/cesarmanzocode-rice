## hyprpaper — wallpaper engine, applied generically to every monitor.
## @WALLPAPER@ is substituted by apply.sh with the installed wallpaper path.
## An empty `monitor` matches every output generically; never hardcode one.

wallpaper {
    monitor =
    path = @WALLPAPER@
    fit_mode = cover
}

splash = 0
ipc = 1
