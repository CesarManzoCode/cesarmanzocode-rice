## hypridle — functional/behavior only, portable across machines.
## Conservative defaults: lock, then screen off; no automatic suspend
## (desktops rarely want that, and it can be surprising/disruptive).
## Adjust timeouts in your own copy after installing if you want them
## tighter/looser — this file is copied, not symlinked, so local edits
## survive until the next ./apply.sh overwrites it.
##
## DPMS is controlled via the current `hl.dsp.dpms` dispatcher through
## hyprctl (hypridle is a separate binary from Hyprland's own Lua config,
## so it can only reach dispatchers through the hyprctl IPC socket, not
## `require`/`hl` directly). `--grace 2` replaces the old
## `general:grace` config key hyprlock dropped.

general {
    lock_cmd = pidof hyprlock || hyprlock --grace 2
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = hyprctl dispatch 'hl.dsp.dpms({ action = "on" })'
}

listener {
    timeout = 300
    on-timeout = loginctl lock-session
}

listener {
    timeout = 420
    on-timeout = hyprctl dispatch 'hl.dsp.dpms({ action = "off" })'
    on-resume = hyprctl dispatch 'hl.dsp.dpms({ action = "on" })'
}

# Suspend is intentionally NOT enabled by default. Uncomment if this
# machine should suspend after a long idle period:
# listener {
#     timeout = 1800
#     on-timeout = systemctl suspend
# }
