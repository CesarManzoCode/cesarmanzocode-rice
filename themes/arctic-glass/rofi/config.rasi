/* Rofi structure — layout only. Colors from the active theme's colors.rasi.

   arctic-glass structural override (see docs/themes/arctic-glass.md
   "Structure"): the mockup wants Rofi to read as "ONE elegant floating
   glass panel, centered, clearly split into a search row + a results
   list, generous internal padding — premium, not utilitarian". Same modi/
   display-drun/on-selection behavior as the shared config.rasi — only
   sizing/padding/borders change, plus a real border-and-gap split between
   inputbar and listview instead of just relying on colors.rasi alone. */
@import "colors.rasi"

configuration {
    modi:                       "drun,run";
    show-icons:                 true;
    /* No icon-theme forced: uses whatever GTK icon theme the system already
       has (installing Papirus just for this would be a new, unrequested
       dependency). */
    display-drun:               "Apps";
    drun-display-format:        "{name}";
    font:                       "JetBrainsMono Nerd Font 11";
}

window {
    /* Wider and more generously padded than the shared 520px/18px — a
       premium, spacious panel rather than a utilitarian popup. */
    width:                      600px;
    location:                   center;
    anchor:                     center;
    padding:                    26px;
    border:                     1px;
    border-radius:              18px;
    background-color:           @background;
    border-color:               @border;
}

mainbox {
    children:                   [ "inputbar", "listview" ];
    /* Wider gap than the shared 12px — makes the search row and the
       results list read as two distinct sections of one panel, not a
       single continuous block. */
    spacing:                    18px;
    background-color:           transparent;
}

inputbar {
    /* Roomier than the shared 12px/14px — the search row is the panel's
       first, most prominent surface. */
    padding:                    16px 18px;
    border-radius:              12px;
    background-color:           @surface;
    /* A visible border here (the shared config.rasi has none) is what
       actually separates the search row from the results list as its own
       card, beyond what @surface's own fill alone would read as. */
    border:                     1px;
    border-color:               @border;
    text-color:                 @foreground;
    children:                   [ "prompt", "entry" ];
}

prompt {
    text-color:                 @muted;
    padding:                    0 10px 0 0;
}

entry {
    placeholder:                "Search…";
    placeholder-color:          @muted;
    text-color:                 @foreground;
}

listview {
    lines:                      8;
    /* More breathing room between result rows than the shared 3px. */
    spacing:                    6px;
    fixed-height:               false;
    scrollbar:                  false;
    /* Rofi 2.0's own built-in default theme (doc/default_theme.rasi)
       gives `listview` a `border: 2px dash 0px 0px` — a dashed line along
       its top edge — that this file never overrode. It's a leftover
       decorative separator from Rofi's stock theme, not a keyboard-focus
       indicator (focus is drawn by the WM/compositor elsewhere, and this
       widget has no separate focus state of its own), so removing it
       loses no accessibility signal: the selected row's full
       white-on-black fill (element selected.*, above) already
       communicates which result is selected, on its own, with or without
       this border. */
    border:                     0;
}

/* ---- element states -------------------------------------------------
   Rofi's theming model crosses two independent axes per row:
     - zebra striping:        normal   / alternate
     - selection + urgency:   normal   / active   / urgent
       (the first also has a "selected" counterpart: selected.normal,
       selected.active, selected.urgent)
   so there are 6 real combinations (normal.normal, normal.active,
   normal.urgent, alternate.normal, alternate.active, alternate.urgent)
   plus their 3 "selected" counterparts. Leaving any of these unset lets
   Rofi fall back to its own built-in default theme for that combination —
   this is exactly what produced the beige rows / blue-grey selection seen
   in earlier builds of this rice. Every combination is themed explicitly
   below; none of them introduce color. */

element {
    padding:                    12px 16px;
    border-radius:              9px;
    text-color:                 @foreground;
}

/* Base rows: a near-imperceptible zebra (zebra vs. transparent), same
   foreground either way — reads as one continuous dark list, not a stack
   of separate row-cards. @zebra is deliberately lower-contrast than
   @surface (reserved for the search bar) — see colors.rasi. */
element normal.normal {
    background-color:           transparent;
    text-color:                 @foreground;
}

element alternate.normal {
    background-color:           @zebra;
    text-color:                 @foreground;
}

/* "active" (e.g. an already-open window in the window switcher) and
   "urgent" both stay strictly monochrome — no accent, no red. */
element normal.active {
    background-color:           transparent;
    text-color:                 @foreground-strong;
}

element alternate.active {
    background-color:           @zebra;
    text-color:                 @foreground-strong;
}

element normal.urgent {
    background-color:           transparent;
    text-color:                 @foreground-strong;
}

element alternate.urgent {
    background-color:           @zebra;
    text-color:                 @foreground-strong;
}

/* Selection always wins: full white row, full black text, regardless of
   zebra stripe or urgency — the one deliberately loud element on screen. */
element selected.normal,
element selected.active,
element selected.urgent {
    background-color:           @foreground-strong;
    text-color:                 @background;
}

element-text {
    background-color:           inherit;
    text-color:                 inherit;
    vertical-align:             0.5;
}

element-icon {
    size:                       20px;
    padding:                    0 10px 0 0;
}
