{
  "manifest_version": 3,
  "name": "cesarmanzocode-rice — ember-forge",
  "version": "1.0.0",
  "description": "Ember-forge browser-chrome theme (frame/toolbar/omnibox/tabs only — no web-content theming) matching this rice's Waybar/Kitty/Rofi/SwayNC carbon/copper palette.",
  "theme": {
    "colors": {
      "frame": [20, 15, 11],
      "frame_inactive": [12, 9, 7],

      "toolbar": [29, 22, 16],
