      "toolbar_button_icon": [234, 224, 213],
      "button_background": [40, 30, 22],

      "omnibox_background": [29, 22, 16],
      "omnibox_text": [234, 224, 213],

      "tab_text": [255, 246, 236],
      "background_tab": [20, 15, 11],
      "background_tab_inactive": [12, 9, 7],
      "tab_background_text": [156, 133, 112],
      "tab_background_text_inactive": [156, 133, 112],

      "bookmark_text": [234, 224, 213],

      "ntp_background": [12, 9, 7],
      "ntp_header": [20, 15, 11],
      "ntp_link": [201, 117, 54],
      "ntp_text": [234, 224, 213]
