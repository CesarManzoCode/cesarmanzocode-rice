// Waybar layout — violet-night's RIGHT VERTICAL RAIL override.
// Structural only: colors live in themes/violet-night/waybar/colors.css,
// imported by this theme's style.css. Every module below is the same
// module/on-click/exec set as the shared config/waybar/config.jsonc —
// nothing dropped, nothing rewired — just reflowed into modules-left/
// -center/-right per Waybar 0.15.0's real contract (verified against
// Bar::Bar and setupWidgets() in the 0.15.0 source): "position": "right"
// alone makes Bar::Bar pick Gtk::ORIENTATION_VERTICAL — there is no
// separate top-level "orientation" key, and setupWidgets() only ever
// wires up modules-left/modules-center/modules-right, never a top-level
// "modules" array, so that key was silently inert (the rail could start
// with zero modules). On a vertical bar Waybar stacks each group
// top-to-bottom, so modules-left/-center/-right becomes the same visual
// top-to-bottom column this theme always intended: launcher+workspaces
// at the top (navigation), clock in the middle (the one "anchor"
// element), status/action modules stacked toward the bottom — mirrors
// ember-forge's left dock, but spacious/atmospheric rather than
// dense/industrial.
{
  "layer": "top",
  "position": "right",
  "width": 64,
  "margin-top": 20,
  "margin-bottom": 20,
  "margin-right": 16,
  // No margin-left: this is a rail, not a floating island — it should
  // read as anchored to the screen edge, with all the breathing room on
  // its top/bottom/right/inner sides instead.
  "margin-left": 0,
  "spacing": 10,

  // On a left/right bar, Waybar stacks modules-left as the TOP group,
  // modules-center as the MIDDLE group, and modules-right as the BOTTOM
  // group (each group's own modules run top-to-bottom within it) — same
  // convention already used by ember-forge's left dock. Grouping mirrors
  // the shared horizontal bar's intent: launcher+workspaces up top
  // (navigation), clock in the visual middle (the one "anchor" element),
  // then status/action modules stacked toward the bottom.
  "modules-left": ["custom/launcher", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "custom/cliphist", "tray", "custom/notification", "custom/power"],

  "custom/launcher": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "rofi -show drun"
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "persistent-workspaces": { "*": 5 }
  },

  // Vertical-friendly clock: a stacked HH / MM read (via \n) stays
  // legible in a narrow column instead of overflowing a wide horizontal
  // string. Tooltip keeps the full date/calendar detail on hover.
  "clock": {
    "format": "{:%H\n%M}",
    "tooltip-format": "<big>{:%A %d %B}</big>\n<tt>{calendar}</tt>"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": { "default": ["", "", ""] },
    "tooltip-format": "{volume}%",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
  },

  "network": {
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "format-linked": "󰈀",
    "tooltip-format-wifi": "{essid}  ·  {signalStrength}%\n{ifname}: {ipaddr}/{cidr}",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected"
  },

  "custom/cliphist": {
    "format": "",
    "tooltip-text": "Clipboard history",
    "on-click": "cliphist list | rofi -dmenu | cliphist decode | wl-copy"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  // Requires the swaync component; if it's disabled on this machine,
  // swaync-client is simply absent and the click is a no-op — same
  // best-effort convention already used by custom/cliphist above (see
  // README "Known limitations"). "alt"/"class" values come straight from
  // `swaync-client -swb`'s own JSON output — verify with that command on
  // the real machine if the icon ever looks wrong for the DND state.
  "custom/notification": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛"
    },
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
    "tooltip": true
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.config/rofi/power-menu.sh"
  }
}
