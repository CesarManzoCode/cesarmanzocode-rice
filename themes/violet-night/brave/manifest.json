{
  "manifest_version": 3,
  "name": "cesarmanzocode-rice — violet-night",
  "version": "1.0.0",
  "description": "Violet-night browser-chrome theme (frame/toolbar/omnibox/tabs only — no web-content theming) matching this rice's Waybar/Kitty/Rofi/SwayNC palette.",
  "theme": {
    "colors": {
      "frame": [16, 13, 29],
      "frame_inactive": [10, 8, 18],

      "toolbar": [30, 24, 54],
